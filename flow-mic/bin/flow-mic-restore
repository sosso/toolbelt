#!/bin/bash
# Restore mic mute state saved by flow-mic-start.
. "$HOME/.local/bin/flow-mic-lib.sh"

[ -f "$STATE" ] || exit 0
while IFS=$'\t' read -r DEV M; do
  [ -n "$DEV" ] || continue
  case "$M" in
    1) "$MICCTL" set-mute "$DEV" on || true ;;
    0) "$MICCTL" set-mute "$DEV" off || true ;;
  esac
done < "$STATE"
exit 0
