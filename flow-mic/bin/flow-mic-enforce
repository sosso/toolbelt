#!/bin/bash
# Wispr Flow asynchronously unmutes the mic 2-4s after dictation stops, so a
# one-shot restore loses the race. Re-apply the saved state for a window after
# stop. Only the muted state needs enforcing (Wispr only ever unmutes).
. "$HOME/.local/bin/flow-mic-lib.sh"

rm -f "$FLAG"
[ -f "$STATE" ] || exit 0
SAVED=$(awk -F'\t' -v mic="$MIC" '$1==mic{print $2}' "$STATE")

if [ "$SAVED" != "1" ]; then
  "$HOME/.local/bin/flow-mic-restore"
  exit 0
fi

END=$((SECONDS + 8))
while [ $SECONDS -lt $END ]; do
  [ -e "$FLAG" ] && exit 0   # a new dictation started; it owns the mic now
  if [ "$("$MICCTL" get-mute "$MIC" 2>/dev/null)" != "1" ]; then
    "$MICCTL" set-mute "$MIC" on || true
  fi
  sleep 0.3
done
exit 0
